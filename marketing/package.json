{
  "name": "lab-booking-marketing",
  "version": "1.0.0",
  "private": true,
  "description": "Video marketing LAB BOOKING (PKK UPI) dengan Remotion",
  "scripts": {
    "studio": "remotion studio",
    "render:vertical": "remotion render MarketingVertical out/lab-booking-vertical.mp4",
    "render:landscape": "remotion render MarketingLandscape out/lab-booking-landscape.mp4",
    "still": "remotion still MarketingVertical out/preview.png --frame=60",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.544",
    "@remotion/google-fonts": "4.0.544",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.544"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
